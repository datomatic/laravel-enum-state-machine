includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        -
            identifier: trait.unused
    configDirectories:
        - config

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
